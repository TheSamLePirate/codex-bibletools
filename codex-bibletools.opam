opam-version: "2.0"
synopsis: "Bible tools and Vatican text explorer in OCaml"
description: "Local Dune project for Bible lookup, Vatican corpus search, GTK interfaces, and text processing."
maintainer: ["maxime"]
authors: ["maxime"]
license: "MIT"
depends: [
  "ocaml"
  "dune"
  "cmdliner"
  "str"
  "yojson"
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
